# Check if the SQL generated by the tdbctl for flush routing is correct

--source suite/tdbctl/inc/tdbctl_conn_init.inc

--connection tdbctl0
SELECT * FROM mysql.servers;
SELECT @@SESSION.tc_admin INTO @origin_tc_admin;
SELECT @@SESSION.tc_enable_autoinc_check INTO @origin_tc_enable_autoinc_check;
SELECT @@GLOBAL.tc_skip_dump_db_list INTO @origin_tc_skip_dump_db_list;
SELECT @@GLOBAL.tc_skip_check_db_list INTO @origin_tc_skip_check_db_list;
SET tc_admin=OFF;
CREATE TEMPORARY TABLE origin_servers LIKE mysql.servers;
INSERT INTO origin_servers SELECT * FROM mysql.servers;

--echo
--echo # Disable tc_enable_autoinc_check
--connection tdbctl0
SET tc_enable_autoinc_check = OFF;

--echo
--echo # Set general_log output to table.
--source suite/tdbctl/inc/set_cluster_general_log_to_table.inc

--echo
--echo # Test Empty routing table
--echo # Truncate mysql.servers.
--connection tdbctl0
SET tc_admin=OFF;
DELETE FROM mysql.servers;
--echo # execute TDBCTL FLUSH ROUTING command.
--connection tdbctl0
SET tc_admin=ON;
--error ER_TCADMIN_FLUSH_ROUTING_ERROR
TDBCTL FLUSH ROUTING;

--echo 
--echo # Only primary tdbctl
--source suite/tdbctl/inc/truncate_cluster_general_log.inc
--connection tdbctl0
SET tc_admin = ON;
--error ER_TCADMIN_INTERNAL_ERROR
TDBCTL CREATE NODE WRAPPER TDBCTL OPTIONS (HOST '172.18.0.9', USER 'mysql', PASSWORD 'mysql', PORT 3306) WITH SCHEMA;
TDBCTL CREATE NODE WRAPPER TDBCTL OPTIONS (HOST '172.18.0.9', USER 'mysql', PASSWORD 'mysql', PORT 3306);
--source suite/tdbctl/inc/get_flush_routing_sql.inc
--source suite/tdbctl/inc/truncate_cluster_general_log.inc
--connection tdbctl0
SET tc_admin = ON;
TDBCTL FLUSH ROUTING;
--source suite/tdbctl/inc/get_flush_routing_sql.inc

--echo
--echo # Only tdbctl nodes
--source suite/tdbctl/inc/truncate_cluster_general_log.inc
--connection tdbctl0
SET tc_admin = ON;
TDBCTL CREATE NODE WRAPPER TDBCTL OPTIONS 
    (HOST '172.18.0.10', USER 'mysql', PASSWORD 'mysql', PORT 3306), 
    (HOST '172.18.0.11', USER 'mysql', PASSWORD 'mysql', PORT 3306);
TDBCTL FLUSH ROUTING;
--source suite/tdbctl/inc/get_flush_routing_sql.inc

--echo
--echo # Add spider nodes
--source suite/tdbctl/inc/truncate_cluster_general_log.inc
--connection tdbctl0
SET tc_admin = ON;
TDBCTL CREATE NODE WRAPPER mysql OPTIONS 
    (HOST '172.18.0.2', USER 'mysql', PASSWORD 'mysql', PORT 3306), 
    (HOST '172.18.0.3', USER 'mysql', PASSWORD 'mysql', PORT 3306);
TDBCTL CREATE NODE WRAPPER mysql_slave OPTIONS
    (HOST '172.18.0.4', USER 'mysql', PASSWORD 'mysql', PORT 3306),
    (HOST '172.18.0.5', USER 'mysql', PASSWORD 'mysql', PORT 3306);
SET GLOBAL tc_skip_dump_db_list = "performance_schema,information_schema,mysql,test,db_infobase,my-test";
SET GLOBAL tc_skip_check_db_list = "performance_schema,information_schema,mysql,test,sys,db_infobase,my-test";
TDBCTL CREATE NODE WRAPPER SPIDER OPTIONS (HOST '172.18.0.6', USER 'mysql', PASSWORD 'mysql', PORT 3306) WITH SCHEMA;
--source suite/tdbctl/inc/get_flush_routing_sql.inc
--source suite/tdbctl/inc/truncate_cluster_general_log.inc
--connection tdbctl0
SET tc_admin = ON;
TDBCTL CREATE NODE WRAPPER SPIDER OPTIONS 
    (HOST '172.18.0.7', USER 'mysql', PASSWORD 'mysql', PORT 3306),
    (HOST '172.18.0.8', USER 'mysql', PASSWORD 'mysql', PORT 3306) 
WITH SCHEMA;
--source suite/tdbctl/inc/get_flush_routing_sql.inc

--echo
--echo # Teset spider_slave nodes 
--connection tdbctl0
SET tc_admin=OFF;
UPDATE mysql.servers SET Wrapper = 'spider_slave' WHERE Host = '172.18.0.8' AND PORT = 3306;
--source suite/tdbctl/inc/truncate_cluster_general_log.inc
--connection tdbctl0
SET tc_admin=ON;
TDBCTL FLUSH ROUTING;
--source suite/tdbctl/inc/get_flush_routing_sql.inc

--echo
--echo # Alter nodes and flush routing cache
--source suite/tdbctl/inc/truncate_cluster_general_log.inc
--connection tdbctl0
SET tc_admin=ON;
TDBCTL ALTER NODE SPT0 OPTIONS (host '127.0.0.4', port 3306) WITH SYNC;
TDBCTL ALTER NODE SPT1 OPTIONS (host '127.0.0.5', port 3306) WITH SYNC;
--source suite/tdbctl/inc/get_flush_routing_sql.inc
--source suite/tdbctl/inc/truncate_cluster_general_log.inc
--connection tdbctl0
SET tc_admin=ON;
TDBCTL FLUSH ROUTING CACHE;
--source suite/tdbctl/inc/get_flush_routing_sql.inc

--echo
--echo # Recover cluster routing
--echo # Restore mysql.servers.
--connection tdbctl0
SET tc_admin=OFF;
TRUNCATE mysql.servers;
INSERT INTO mysql.servers SELECT * FROM origin_servers;
--echo # Truncate general_log.
--source suite/tdbctl/inc/truncate_cluster_general_log.inc
--echo # execute TDBCTL FLUSH ROUTING command.
--connection tdbctl0
SET tc_admin=ON;
TDBCTL FLUSH ROUTING;
--source suite/tdbctl/inc/get_flush_routing_sql.inc

--echo
--echo # Restore to the initial state.
--source suite/tdbctl/inc/reset_cluster_general_log.inc
--connection tdbctl0
SET tc_admin=OFF;
DROP TEMPORARY TABLE origin_servers;
SET @@GLOBAL.tc_skip_dump_db_list = @origin_tc_skip_dump_db_list;
SET @@GLOBAL.tc_skip_check_db_list = @origin_tc_skip_check_db_list;
SET @@SESSION.tc_enable_autoinc_check = @origin_tc_enable_autoinc_check;
SET @@SESSION.tc_admin = @origin_tc_admin;

