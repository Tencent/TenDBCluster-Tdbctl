# If you want to check forwarding rules for specific commands, add test cases in this file.

--source suite/tdbctl/inc/tdbctl_conn_init.inc

--connection tdbctl0
SELECT * FROM mysql.servers;
SELECT @@SESSION.tc_admin INTO @origin_tc_admin;

--echo
--echo # Set general_log output to table.
--source suite/tdbctl/inc/set_cluster_general_log_to_table.inc

--echo
--echo # check forwarding rules for SQLCOM_SET_OPTION command.
--echo # Truncate general_log.
--source suite/tdbctl/inc/truncate_cluster_general_log.inc
--echo # execute SQLCOM_SET_OPTION command.
--connection tdbctl0
SET tc_admin=ON;
--disable_warnings
SET @old_level = @@SESSION.tx_isolation;
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
SET SESSION tx_isolation = @old_level;
--enable_warnings
--echo # show general_log.
--source suite/tdbctl/inc/get_cluster_general_log.inc


--echo
--echo # check forwarding rules for SQLCOM_LOCK_TABLES and SQLCOM_UNLOCK_TABLES command.
--echo # Truncate general_log.
--source suite/tdbctl/inc/truncate_cluster_general_log.inc
--echo # execute SQLCOM_LOCK_TABLES and SQLCOM_UNLOCK_TABLES command.
--connection tdbctl0
SET tc_admin=ON;
CREATE DATABASE test1;
USE test1;
CREATE TABLE t1( id INT PRIMARY KEY );
CREATE TABLE t2( id INT PRIMARY KEY );
LOCK TABLES t1 READ, t2 WRITE;
UNLOCK TABLES;
DROP DATABASE test1;
--echo # show general_log.
--source suite/tdbctl/inc/get_cluster_general_log.inc

--echo
--echo # Restore to the initial state.
--source suite/tdbctl/inc/reset_cluster_general_log.inc
--connection tdbctl0
SET @@SESSION.tc_admin = @origin_tc_admin;