# Test the command 'TDBCTL CREATE NODE' with multiple nodes.

--source suite/tdbctl/inc/tdbctl_conn_init.inc

--connection tdbctl0
SELECT @@SESSION.tc_admin INTO @origin_tc_admin;
SELECT @@SESSION.tc_enable_autoinc_check INTO @origin_tc_enable_autoinc_check;
SELECT @@GLOBAL.tc_skip_dump_db_list INTO @origin_tc_skip_dump_db_list;
SELECT @@GLOBAL.tc_routing_log_file INTO @origin_tc_routing_log_file;
SELECT @@GLOBAL.tc_routing_log INTO @origin_tc_routing_log;
SELECT @@SESSION.tc_read_timeout INTO @origin_tc_read_timeout;
SET tc_admin=OFF;
CREATE TEMPORARY TABLE origin_servers LIKE mysql.servers;
INSERT INTO origin_servers SELECT * FROM mysql.servers;

--echo
--echo # Original routing table.
SELECT * FROM mysql.servers;


--echo
--echo # Case 1: TDBCTL CREATE NODE execution failed due to option validation check failure.

--echo
--echo # Set routing.
--connection tdbctl0
SET tc_admin=ON;
TDBCTL DROP NODE SPIDER0;
TDBCTL DROP NODE SPIDER1;
TDBCTL DROP NODE SPIDER2;
TDBCTL FLUSH ROUTING;
SELECT * FROM mysql.servers;

--echo
--echo # Skip dump database.
--connection tdbctl0
SET tc_admin=ON;
SET GLOBAL tc_skip_dump_db_list = "performance_schema,information_schema,mysql,test,db_infobase,my-test";
--echo

--echo # Missing required options
--error ER_TCADMIN_CREATE_NODE_ERROR
TDBCTL CREATE NODE WRAPPER SPIDER OPTIONS 
    (HOST '172.18.0.6', USER 'mysql', PASSWORD 'mysql', PORT 3306), 
    (HOST '172.18.0.7', USER 'mysql', PASSWORD 'mysql', PORT 3306),
    (HOST '172.18.0.8', USER 'mysql', PASSWORD 'mysql');
--error ER_TCADMIN_CREATE_NODE_ERROR
TDBCTL CREATE NODE WRAPPER SPIDER OPTIONS 
    (HOST '172.18.0.6', USER 'mysql', PASSWORD 'mysql', PORT 3306), 
    (HOST '172.18.0.7', USER 'mysql', PORT 3306),
    (HOST '172.18.0.8', USER 'mysql', PASSWORD 'mysql', PORT 3306)
    WITH SCHEMA;

--echo # NUMBER options cannot be specified when adding multiple servers
--error ER_TCADMIN_CREATE_NODE_ERROR
TDBCTL CREATE NODE WRAPPER SPIDER OPTIONS 
    (HOST '172.18.0.6', USER 'mysql', PASSWORD 'mysql', PORT 3306), 
    (HOST '172.18.0.7', USER 'mysql', PASSWORD 'mysql', PORT 3306, NUMBER 1),
    (HOST '172.18.0.8', USER 'mysql', PASSWORD 'mysql', PORT 3306);
--error ER_TCADMIN_CREATE_NODE_ERROR
TDBCTL CREATE NODE WRAPPER SPIDER OPTIONS 
    (HOST '172.18.0.6', USER 'mysql', PASSWORD 'mysql', PORT 3306), 
    (HOST '172.18.0.7', USER 'mysql', PASSWORD 'mysql', PORT 3306),
    (HOST '172.18.0.8', USER 'mysql', PASSWORD 'mysql', PORT 3306, NUMBER 2)
    WITH SCHEMA;

--echo # The specified ip#port already exists
--error ER_TCADMIN_CREATE_NODE_ERROR
TDBCTL CREATE NODE WRAPPER SPIDER OPTIONS
    (HOST '172.18.0.6', USER 'mysql', PASSWORD 'mysql', PORT 3306),
    (HOST '172.18.0.7', USER 'mysql', PASSWORD 'mysql', PORT 3306),
    (HOST '172.18.0.7', USER 'mysql', PASSWORD 'mysql', PORT 3306);
--error ER_TCADMIN_CREATE_NODE_ERROR
TDBCTL CREATE NODE WRAPPER SPIDER OPTIONS
    (HOST '172.18.0.6', USER 'mysql', PASSWORD 'mysql', PORT 3306),
    (HOST '172.18.0.7', USER 'mysql', PASSWORD 'mysql', PORT 3306),
    (HOST '172.18.0.6', USER 'mysql', PASSWORD 'mysql', PORT 3306)
    WITH SCHEMA;
--error ER_TCADMIN_CREATE_NODE_ERROR
TDBCTL CREATE NODE WRAPPER SPIDER OPTIONS 
    (HOST '172.18.0.6', USER 'mysql', PASSWORD 'mysql', PORT 3306), 
    (HOST '172.18.0.7', USER 'mysql', PASSWORD 'mysql', PORT 3306),
    (HOST '172.18.0.5', USER 'mysql', PASSWORD 'mysql', PORT 3306);
--error ER_TCADMIN_CREATE_NODE_ERROR
TDBCTL CREATE NODE WRAPPER SPIDER OPTIONS 
    (HOST '172.18.0.6', USER 'mysql', PASSWORD 'mysql', PORT 3306), 
    (HOST '172.18.0.7', USER 'mysql', PASSWORD 'mysql', PORT 3306),
    (HOST '172.18.0.11', USER 'mysql', PASSWORD 'mysql', PORT 3306)
    WITH SCHEMA;

--echo # The specified ip is not consistent with the cluster
--error ER_TCADMIN_CREATE_NODE_ERROR
TDBCTL CREATE NODE WRAPPER SPIDER OPTIONS 
    (HOST '172.18.0.6', USER 'mysql', PASSWORD 'mysql', PORT 3306), 
    (HOST '172.18.0.7', USER 'mysql', PASSWORD 'mysql', PORT 3306),
    (HOST '127.0.0.1', USER 'mysql', PASSWORD 'mysql', PORT 3306);
--error ER_TCADMIN_CREATE_NODE_ERROR
TDBCTL CREATE NODE WRAPPER SPIDER OPTIONS 
    (HOST '172.18.0.6', USER 'mysql', PASSWORD 'mysql', PORT 3306), 
    (HOST '172.18.0.7', USER 'mysql', PASSWORD 'mysql', PORT 3306),
    (HOST 'localhost', USER 'mysql', PASSWORD 'mysql', PORT 3306)
    WITH SCHEMA;

--echo # server index has reached the maximum limit
TDBCTL CREATE NODE WRAPPER SPIDER OPTIONS (HOST '172.18.0.6', USER 'mysql', PASSWORD 'mysql', PORT 3306, NUMBER 9223372036854775807);
--error ER_TCADMIN_CREATE_NODE_ERROR
TDBCTL CREATE NODE WRAPPER SPIDER OPTIONS (HOST '172.18.0.7', USER 'mysql', PASSWORD 'mysql', PORT 3306);
TDBCTL DROP NODE SPIDER9223372036854775807;
TDBCTL CREATE NODE WRAPPER SPIDER OPTIONS (HOST '172.18.0.6', USER 'mysql', PASSWORD 'mysql', PORT 3306, NUMBER 9223372036854775806);
--error ER_TCADMIN_CREATE_NODE_ERROR
TDBCTL CREATE NODE WRAPPER SPIDER OPTIONS 
    (HOST '172.18.0.7', USER 'mysql', PASSWORD 'mysql', PORT 3306),
    (HOST '172.18.0.8', USER 'mysql', PASSWORD 'mysql', PORT 3306);
TDBCTL DROP NODE SPIDER9223372036854775806;


--echo
--echo # Case 2: TDBCTL CREATE NODE execution failed due to auto-increment configuration conflicts.

--echo
--connection tdbctl0
SET tc_admin=ON;
--error ER_TCADMIN_CREATE_NODE_ERROR
TDBCTL CREATE NODE WRAPPER SPIDER OPTIONS 
    (HOST '172.18.0.6', USER 'mysql', PASSWORD 'mysql', PORT 3306), 
    (HOST '172.18.0.7', USER 'mysql', PASSWORD 'mysql', PORT 3306),
    (HOST '172.18.0.8', USER 'mysql', PASSWORD 'mysql', PORT 3306)
    WITH SCHEMA;
SET tc_enable_autoinc_check = OFF;
TDBCTL CREATE NODE WRAPPER SPIDER OPTIONS 
    (HOST '172.18.0.6', USER 'mysql', PASSWORD 'mysql', PORT 3306), 
    (HOST '172.18.0.7', USER 'mysql', PASSWORD 'mysql', PORT 3306),
    (HOST '172.18.0.8', USER 'mysql', PASSWORD 'mysql', PORT 3306)
    WITH SCHEMA;
SET tc_enable_autoinc_check = ON;
SELECT * FROM mysql.servers;

--echo
--echo # Restore mysql.servers;
--connection tdbctl0
SET tc_admin=OFF;
TRUNCATE mysql.servers;
INSERT INTO mysql.servers SELECT * FROM origin_servers;
SET tc_admin=ON;
TDBCTL FLUSH ROUTING;

--echo
--echo # Case 3: Test the rollback functionality of the TDBCTL CREATE NODE command.

--echo
--echo # Set routing.
--connection tdbctl0
SET tc_admin=ON;
TDBCTL DROP NODE SPIDER0;
TDBCTL DROP NODE SPIDER1;
TDBCTL DROP NODE SPIDER2;
TDBCTL FLUSH ROUTING;
SELECT * FROM mysql.servers;
SELECT * FROM information_schema.TDBCTL_SERVER_CACHE;

--echo
--echo # Skip database backup and autoinc check
--connection tdbctl0
SET tc_admin=ON;
SET GLOBAL tc_skip_dump_db_list = "performance_schema,information_schema,mysql,test,db_infobase,my-test";
SET tc_enable_autoinc_check = OFF;

--echo
--echo # Set tc_read_timeout
SET SESSION tc_read_timeout = 3;

--echo 
--echo # Get datadir
--connection tdbctl0
--let $data_dir = `SELECT @@global.datadir`
--echo datadir:$data_dir

--echo
--echo # Lock TDBCTL1 mysql.user
--echo # tdbctl1 session
--connection tdbctl1
SET tc_admin=OFF;
LOCK TABLE mysql.user WRITE;

--echo
--connection tdbctl0
--let $log_path = $data_dir/create_nodes_rollback1
--echo # Set routing log: $log_path
--eval SET @@GLOBAL.tc_routing_log_file = '$log_path';
SET @@GLOBAL.tc_routing_log = ON;
--echo # Failed during the "do grants" part, roll back the changes to the mysql.servers table and server_cache
--error ER_NET_READ_INTERRUPTED
TDBCTL CREATE NODE WRAPPER SPIDER OPTIONS 
    (HOST '172.18.0.6', USER 'mysql', PASSWORD 'mysql', PORT 3306), 
    (HOST '172.18.0.7', USER 'mysql', PASSWORD 'mysql', PORT 3306),
    (HOST '172.18.0.8', USER 'mysql', PASSWORD 'mysql', PORT 3306);
SELECT * FROM mysql.servers;
SELECT * FROM information_schema.TDBCTL_SERVER_CACHE;
--echo 
--echo # Show routing log
--exec docker exec ctl0 cat $log_path | sed -e 's/^Time:.*/Time: <ignored>/' -e 's/^Thread_id:.*/Thread_id: <ignored>/' -e 's/(version_num: [0-9]\+)/(version_num: <ignored>)/'

--echo
--echo # Unlock TDBCTL1 mysql.user and Lock TDBCTL1 mysql.servers
--echo # tdbctl1 session
--connection tdbctl1
UNLOCK TABLES;
LOCK TABLE mysql.servers WRITE;

--echo
--connection tdbctl0
--let $log_path = $data_dir/create_nodes_rollback2
--echo # Set routing log: $log_path
--eval SET @@GLOBAL.tc_routing_log_file = '$log_path';
SET @@GLOBAL.tc_routing_log = ON;
--echo # Failed during the "flush routing" part, roll back the changes to the mysql.servers table and server_cache
--error ER_TCADMIN_CREATE_NODE_ERROR
TDBCTL CREATE NODE WRAPPER SPIDER OPTIONS 
    (HOST '172.18.0.6', USER 'mysql', PASSWORD 'mysql', PORT 3306), 
    (HOST '172.18.0.7', USER 'mysql', PASSWORD 'mysql', PORT 3306),
    (HOST '172.18.0.8', USER 'mysql', PASSWORD 'mysql', PORT 3306)
    WITH SCHEMA;
SELECT * FROM mysql.servers;
SELECT * FROM information_schema.TDBCTL_SERVER_CACHE;
--echo 
--echo # Show routing log
--exec docker exec ctl0 cat $log_path | sed -e 's/^Time:.*/Time: <ignored>/' -e 's/^Thread_id:.*/Thread_id: <ignored>/' -e 's/(version_num: [0-9]\+)/(version_num: <ignored>)/'

--echo
--echo # Unlock TDBCTL1 tables
--echo # tdbctl1 session
--connection tdbctl1
UNLOCK TABLES;

--echo
--echo # Restore mysql.servers;
--connection tdbctl0
SET tc_admin=OFF;
TRUNCATE mysql.servers;
INSERT INTO mysql.servers SELECT * FROM origin_servers;
SET tc_admin=ON;
TDBCTL FLUSH ROUTING;

--echo
--echo # Restore to the initial state.
--connection tdbctl0
SET tc_admin=OFF;
DROP TEMPORARY TABLE origin_servers;
SET @@SESSION.tc_read_timeout = @origin_tc_read_timeout;
SET @@GLOBAL.tc_routing_log = @origin_tc_routing_log;
SET @@GLOBAL.tc_routing_log_file = @origin_tc_routing_log_file;
SET @@GLOBAL.tc_skip_dump_db_list = @origin_tc_skip_dump_db_list;
SET @@SESSION.tc_enable_autoinc_check = @origin_tc_enable_autoinc_check;
SET @@SESSION.tc_admin = @origin_tc_admin;