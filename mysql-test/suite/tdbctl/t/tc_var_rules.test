
--source suite/tdbctl/inc/tdbctl_conn_init.inc

--connection tdbctl0
SELECT * FROM mysql.servers;
SELECT @@SESSION.tc_admin INTO @origin_tc_admin;
SELECT @@GLOBAL.tc_forwarding_rules INTO @origin_global_sql_rules;
SELECT @@SESSION.tc_forwarding_rules INTO @origin_session_sql_rules;
SELECT @@GLOBAL.tc_set_forwarding_rules INTO @origin_global_var_rules;
SELECT @@SESSION.tc_set_forwarding_rules INTO @origin_session_var_rules;

--echo
--echo # Test invalid variable forwarding rules.
--connection tdbctl0
--error ER_VAR_RULES_CHECK_UNPASS
SET tc_set_forwarding_rules = NULL;
--error ER_VAR_RULES_CHECK_UNPASS
SET tc_set_forwarding_rules = '""';
--error ER_VAR_RULES_CHECK_UNPASS
SET tc_set_forwarding_rules = '{"max_connections", "TDBCTL", "time_zone", "TDBCTL"}';
--error ER_VAR_RULES_CHECK_UNPASS
SET tc_set_forwarding_rules = '{max_connections: "TDBCTL", time_zone: "TDBCTL"}';
--error ER_VAR_RULES_CHECK_UNPASS
SET tc_set_forwarding_rules = '{"time_zone": 123}';
--error ER_VAR_RULES_CHECK_UNPASS
SET tc_set_forwarding_rules = '{"tc_admin": "TDBCTL, SPIDER_ALL"}';
--error ER_VAR_RULES_CHECK_UNPASS
SET tc_set_forwarding_rules = '{"time_zone": ""}';
--error ER_VAR_RULES_CHECK_UNPASS
SET tc_set_forwarding_rules = '{"time_zone": "TDBCTL_ALL"}';
--error ER_VAR_RULES_CHECK_UNPASS
SET tc_set_forwarding_rules = '{"time_zone": "DESIGNATED_ONE"}';
--error ER_VAR_RULES_CHECK_UNPASS
SET tc_set_forwarding_rules = '{"time_zone": "SPIDER_ALL, TDBCTL, SPIDER_ALL"}';
--error ER_VAR_RULES_CHECK_UNPASS
SET tc_set_forwarding_rules = '{"time_zone": "SPIDER_ALL, TDBCTL, SPIDER_ONE"}';

SET tc_set_forwarding_rules = '{"Unknown_sys_var": "TDBCTL"}';
SHOW VARIABLES LIKE 'tc_set_forwarding_rules';
SET tc_set_forwarding_rules = default;
SHOW VARIABLES LIKE 'tc_set_forwarding_rules';

--echo
--echo # Set global tc_set_forwarding_rules. Only new sessions will be affected.
--connection tdbctl0
SHOW SESSION VARIABLES LIKE 'tc_forwarding_rules';
SHOW GLOBAL VARIABLES LIKE 'tc_forwarding_rules';
SHOW SESSION VARIABLES LIKE 'tc_set_forwarding_rules';
SHOW GLOBAL VARIABLES LIKE 'tc_set_forwarding_rules';
SET GLOBAL tc_set_forwarding_rules = '{"time_zone": "TDBCTL", "max_connections": "TDBCTL, SPIDER_ONE"}';
SHOW GLOBAL VARIABLES LIKE 'tc_set_forwarding_rules';
SET @@GLOBAL.tc_set_forwarding_rules = JSON_SET(@@GLOBAL.tc_set_forwarding_rules, '$.net_read_timeout', 'TDBCTL, REMOTE_ALL');
SHOW GLOBAL VARIABLES LIKE 'tc_set_forwarding_rules';
SET @@GLOBAL.tc_set_forwarding_rules = JSON_REMOVE(@@GLOBAL.tc_set_forwarding_rules, '$.max_connections');
SHOW GLOBAL VARIABLES LIKE 'tc_set_forwarding_rules';
SET @@GLOBAL.tc_set_forwarding_rules = JSON_SET(@@GLOBAL.tc_set_forwarding_rules, '$.net_read_timeout', 'NO_EXEC');
SHOW GLOBAL VARIABLES LIKE 'tc_set_forwarding_rules';
SELECT JSON_EXTRACT(@@GLOBAL.tc_set_forwarding_rules, '$.net_read_timeout') AS rule_of_net_read_timeout;
SHOW SESSION VARIABLES LIKE 'tc_set_forwarding_rules';

--echo
--echo # Create new connection.
--connect (new_session, 127.0.0.1, root, 123, test, 46000,)
--connection new_session
SHOW GLOBAL VARIABLES LIKE 'tc_forwarding_rules';
SHOW SESSION VARIABLES LIKE 'tc_forwarding_rules';
SHOW GLOBAL VARIABLES LIKE 'tc_set_forwarding_rules';
SHOW SESSION VARIABLES LIKE 'tc_set_forwarding_rules';

--echo
--echo # Set general_log output to table.
--source suite/tdbctl/inc/set_cluster_general_log_to_table.inc


--echo
--echo # Check default forwarding rule for the SQLCOM_SET_OPTION command.
--echo # Truncate general_log.
--source suite/tdbctl/inc/truncate_cluster_general_log.inc
--echo # Execute SQLCOM_SET_OPTION commands of different variable types.
--echo # Still in the old session.
--connection tdbctl0
SET tc_admin = ON;
SET @origin_time_zone = @@SESSION.time_zone;
SET time_zone = '+00:00';
SET time_zone = @origin_time_zone;
SET @origin_net_read_timeout = @@SESSION.net_read_timeout;
show variables like 'net_read_timeout';
SET net_read_timeout = 600;
show variables like 'net_read_timeout';
SET net_read_timeout = @origin_net_read_timeout;
SET @origin_max_connections = @@GLOBAL.max_connections;
SET GLOBAL max_connections = 64;
SET GLOBAL max_connections = @origin_max_connections;
--error ER_TCADMIN_EXECUTE_ERROR
SET tc_admin = OFF, time_zone = default;
--echo # Show general_log.
--source suite/tdbctl/inc/get_cluster_general_log.inc


--echo
--echo # Check modified forwarding rules for SQLCOM_SET_OPTION commands of system variables.
--echo # Truncate general_log.
--source suite/tdbctl/inc/truncate_cluster_general_log.inc
--echo # Execute SQLCOM_SET_OPTION commands of different variable types.
--echo # Go to the new session.
--connection new_session
SET tc_admin=ON;
SET @origin_time_zone = @@SESSION.time_zone;
SET time_zone = '+00:00';
SET time_zone = @origin_time_zone;
SET @origin_net_read_timeout = @@SESSION.net_read_timeout;
show variables like 'net_read_timeout';
SET net_read_timeout = 600;
show variables like 'net_read_timeout';
SET net_read_timeout = @origin_net_read_timeout;
SET @origin_max_connections = @@GLOBAL.max_connections;
SET GLOBAL max_connections = 64;
SET GLOBAL max_connections = @origin_max_connections;
--error ER_TCADMIN_EXECUTE_ERROR
SET tc_admin = OFF, time_zone = default;
--echo # show general_log.
--echo --------------------
--connection new_session
SET tc_admin=OFF;
SELECT argument AS tdbctl0_log FROM mysql.general_log WHERE (user_host LIKE '%172.18.0.9%' OR thread_id = CONNECTION_ID()) AND argument NOT LIKE '%tdbctl0_log%' AND command_type NOT LIKE 'Connect';
--echo --------------------
--connection spider0
SELECT argument AS spider0_log FROM mysql.general_log WHERE user_host LIKE '%172.18.0.9%' AND argument NOT LIKE '%spider0_log%' AND command_type NOT LIKE 'Connect';
--echo --------------------
--connection spider1
SELECT argument AS spider1_log FROM mysql.general_log WHERE user_host LIKE '%172.18.0.9%' AND argument NOT LIKE '%spider1_log%' AND command_type NOT LIKE 'Connect';
--echo --------------------
--connection spider2
SELECT argument AS spider2_log FROM mysql.general_log WHERE user_host LIKE '%172.18.0.9%' AND argument NOT LIKE '%spider2_log%' AND command_type NOT LIKE 'Connect';
--echo --------------------
--connection remote_master0
SELECT argument AS remote_master0_log FROM mysql.general_log WHERE user_host LIKE '%172.18.0.9%' AND argument NOT LIKE '%remote_master0_log%' AND command_type NOT LIKE 'Connect';
--echo --------------------
--connection remote_master1
SELECT argument AS remote_master1_log FROM mysql.general_log WHERE user_host LIKE '%172.18.0.9%' AND argument NOT LIKE '%remote_master1_log%' AND command_type NOT LIKE 'Connect';
--echo --------------------


--echo
--echo # Set session tc_set_forwarding_rules and tc_forwarding_rules. Only the current session will be affected.
--echo # Go to the new session.
--connection new_session
SET SESSION tc_forwarding_rules = '{"SQLCOM_SET_OPTION": "TDBCTL"}';
SHOW GLOBAL VARIABLES LIKE 'tc_forwarding_rules';
SHOW SESSION VARIABLES LIKE 'tc_forwarding_rules';
SET SESSION tc_set_forwarding_rules = '{"time_zone": "TDBCTL, SPIDER_ALL, REMOTE_ALL", "net_read_timeout": "TDBCTL, SPIDER_ALL"}';
SHOW GLOBAL VARIABLES LIKE 'tc_set_forwarding_rules';
SHOW SESSION VARIABLES LIKE 'tc_set_forwarding_rules';


--echo
--echo # Check default forwarding rule for the SQLCOM_SET_OPTION command.
--echo # Truncate general_log.
--source suite/tdbctl/inc/truncate_cluster_general_log.inc
--echo # Execute SQLCOM_SET_OPTION commands of different variable types.
--echo # Still in the old session.
--connection tdbctl0
SET tc_admin = ON;
SET time_zone = '+00:00';
SET time_zone = default;
SET net_read_timeout = 600, net_write_timeout = 600;
SET net_read_timeout = default, net_write_timeout = default;
SET @origin_max_connections = @@GLOBAL.max_connections;
SET GLOBAL max_connections = 64;
SET GLOBAL max_connections = @origin_max_connections;
--echo # Show general_log.
--source suite/tdbctl/inc/get_cluster_general_log.inc


--echo
--echo # Check modified forwarding rules for SQLCOM_SET_OPTION commands of system variables.
--echo # Truncate general_log.
--source suite/tdbctl/inc/truncate_cluster_general_log.inc
--echo # Execute SQLCOM_SET_OPTION commands of different variable types.
--echo # Go to the new session.
--connection new_session
SET tc_admin = ON;
SET time_zone = '+00:00';
SET time_zone = default;
--error ER_TCADMIN_EXECUTE_ERROR
SET net_read_timeout = 600, net_write_timeout = 600;
--error ER_TCADMIN_EXECUTE_ERROR
SET net_read_timeout = default, net_write_timeout = default;
SET @origin_max_connections = @@GLOBAL.max_connections;
SET GLOBAL max_connections = 64;
SET GLOBAL max_connections = @origin_max_connections;
--echo # show general_log.
--echo --------------------
--connection new_session
SET tc_admin=OFF;
SELECT argument AS tdbctl0_log FROM mysql.general_log WHERE (user_host LIKE '%172.18.0.9%' OR thread_id = CONNECTION_ID()) AND argument NOT LIKE '%tdbctl0_log%' AND command_type NOT LIKE 'Connect';
--echo --------------------
--connection spider0
SELECT argument AS spider0_log FROM mysql.general_log WHERE user_host LIKE '%172.18.0.9%' AND argument NOT LIKE '%spider0_log%' AND command_type NOT LIKE 'Connect';
--echo --------------------
--connection spider1
SELECT argument AS spider1_log FROM mysql.general_log WHERE user_host LIKE '%172.18.0.9%' AND argument NOT LIKE '%spider1_log%' AND command_type NOT LIKE 'Connect';
--echo --------------------
--connection spider2
SELECT argument AS spider2_log FROM mysql.general_log WHERE user_host LIKE '%172.18.0.9%' AND argument NOT LIKE '%spider2_log%' AND command_type NOT LIKE 'Connect';
--echo --------------------
--connection remote_master0
SELECT argument AS remote_master0_log FROM mysql.general_log WHERE user_host LIKE '%172.18.0.9%' AND argument NOT LIKE '%remote_master0_log%' AND command_type NOT LIKE 'Connect';
--echo --------------------
--connection remote_master1
SELECT argument AS remote_master1_log FROM mysql.general_log WHERE user_host LIKE '%172.18.0.9%' AND argument NOT LIKE '%remote_master1_log%' AND command_type NOT LIKE 'Connect';
--echo --------------------

--echo
--echo # A case from mysqldump.
--echo # Go to the new session.
--connection new_session

--echo # Preparation: Set improper time zone and create database;
SET SESSION tc_forwarding_rules = '{"SQLCOM_SET_OPTION": "TDBCTL, SPIDER_ALL, REMOTE_ALL"}';
SET tc_admin = ON;
SET @origin_time_zone = @@time_zone;
SET time_zone = '+08:00';
CREATE DATABASE test_time_zone;
USE test_time_zone;
SET SESSION tc_forwarding_rules = default;
SET SESSION tc_set_forwarding_rules = default;

--echo # Although "set time_zone" is not forwarded to remote at this time, it still executes successfully because tdbctl synchronizes system variables like time_zone before distributing SQL
SET time_zone = '+00:00';
# --error ER_TCADMIN_EXECUTE_ERROR  # In the past, tdbctl did not synchronize time_zone, so execution would fail when distributed to remote
CREATE TABLE procmanage_cmd_template (
  id bigint(20) NOT NULL AUTO_INCREMENT COMMENT 'ID',
  content text NOT NULL COMMENT '命令的具体内容',
  create_at timestamp NOT NULL DEFAULT '1970-01-01 00:00:01' COMMENT '创建时间',
  update_at timestamp NOT NULL DEFAULT '1970-01-01 00:00:01' ON UPDATE CURRENT_TIMESTAMP COMMENT '最后一次修改时间',
  PRIMARY KEY (id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

DROP TABLE IF EXISTS procmanage_cmd_template;

--echo # Success to create table
SET SESSION tc_set_forwarding_rules = '{"time_zone": "TDBCTL, SPIDER_ALL, REMOTE_ALL"}';
SET time_zone = '+00:00';
CREATE TABLE procmanage_cmd_template (
  id bigint(20) NOT NULL AUTO_INCREMENT COMMENT 'ID',
  content text NOT NULL COMMENT '命令的具体内容',
  create_at timestamp NOT NULL DEFAULT '1970-01-01 00:00:01' COMMENT '创建时间',
  update_at timestamp NOT NULL DEFAULT '1970-01-01 00:00:01' ON UPDATE CURRENT_TIMESTAMP COMMENT '最后一次修改时间',
  PRIMARY KEY (id)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4;

--echo # Restore time zone
SET SESSION tc_forwarding_rules = '{"SQLCOM_SET_OPTION": "TDBCTL, SPIDER_ALL, REMOTE_ALL"}';
SET time_zone = @origin_time_zone;


--echo
--echo # Restore to the initial state.
--source suite/tdbctl/inc/reset_cluster_general_log.inc
--disconnect new_session
--connection tdbctl0
SET @@SESSION.tc_set_forwarding_rules = @origin_session_var_rules;
SET @@GLOBAL.tc_set_forwarding_rules = @origin_global_var_rules;
SET @@SESSION.tc_forwarding_rules = @origin_session_sql_rules;
SET @@GLOBAL.tc_forwarding_rules = @origin_global_sql_rules;
SET @@SESSION.tc_admin = @origin_tc_admin;