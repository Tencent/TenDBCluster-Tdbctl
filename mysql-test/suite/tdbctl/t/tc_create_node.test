--echo
--echo # Set routing.
--connection tdbctl0
SET tc_admin=ON;
TDBCTL DROP NODE SPT1;
TDBCTL FLUSH ROUTING;

--echo
--echo # Show routing.
--connection tdbctl0
SELECT * FROM mysql.servers;

--echo
--echo # Case 4: TDBCTL CREATE REMOTE NODE WITH SCHEMA.
--echo # execute TDBCTL CREATE NODE WITH SCHEMA.
--connection tdbctl0
SET tc_admin=ON;
SET GLOBAL tc_skip_dump_db_list = "performance_schema,information_schema,mysql,test,db_infobase,my-test";
SET GLOBAL tc_skip_check_db_list = "performance_schema,information_schema,mysql,test,sys,db_infobase,my-test";
--error ER_TCADMIN_CREATE_NODE_ERROR
TDBCTL CREATE NODE WRAPPER mysql OPTIONS (HOST '172.18.0.3', USER 'mysql', PASSWORD 'mysql', PORT 3306) WITH SCHEMA;

--echo
--echo # Restore mysql.servers;
--connection tdbctl0
SET tc_admin=OFF;
TRUNCATE mysql.servers;
INSERT INTO mysql.servers SELECT * FROM origin_servers;
SET tc_admin=ON;
TDBCTL FLUSH ROUTING;

--echo
--echo # Restore to the initial state.
--source suite/tdbctl/inc/reset_cluster_general_log.inc
--connection tdbctl0
SET tc_admin=OFF;
DROP TEMPORARY TABLE origin_servers;
SET @@GLOBAL.tc_skip_dump_db_list = @origin_tc_skip_dump_db_list;
SET @@GLOBAL.tc_skip_check_db_list = @origin_tc_skip_check_db_list;
SET @@SESSION.tc_enable_autoinc_check = @origin_tc_enable_autoinc_check;
SET @@SESSION.tc_admin = @origin_tc_admin;