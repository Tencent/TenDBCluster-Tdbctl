# Test the command 'TDBCTL CREATE NODE'.

--source suite/tdbctl/inc/tdbctl_conn_init.inc

--connection tdbctl0
SELECT @@SESSION.tc_admin INTO @origin_tc_admin;
SELECT @@SESSION.tc_enable_autoinc_check INTO @origin_tc_enable_autoinc_check;
SELECT @@GLOBAL.tc_skip_dump_db_list INTO @origin_tc_skip_dump_db_list;
SELECT @@GLOBAL.tc_skip_check_db_list INTO @origin_tc_skip_check_db_list;
SET tc_admin=OFF;
CREATE TEMPORARY TABLE origin_servers LIKE mysql.servers;
INSERT INTO origin_servers SELECT * FROM mysql.servers;

--echo
--echo # Disable tc_enable_autoinc_check
--connection tdbctl0
SET tc_enable_autoinc_check = OFF;

--echo
--echo # Original routing table.
SELECT * FROM mysql.servers;

--echo
--echo # Set routing.
--connection tdbctl0
SET tc_admin=ON;
TDBCTL DROP NODE SPIDER2;
TDBCTL FLUSH ROUTING;

--echo
--echo # Show routing.
--connection tdbctl0
SELECT * FROM mysql.servers;

--echo
--echo # Case 0: TDBCTL CREATE NODE execution failed due to option validation check failure.
--connection tdbctl0
SET tc_admin=ON;
SET GLOBAL tc_skip_dump_db_list = "performance_schema,information_schema,mysql,test,db_infobase,my-test";
SET GLOBAL tc_skip_check_db_list = "performance_schema,information_schema,mysql,test,sys,db_infobase,my-test";
--echo # Missing required options
--error ER_TCADMIN_CREATE_NODE_ERROR
TDBCTL CREATE NODE WRAPPER SPIDER OPTIONS (HOST '172.18.0.8', USER 'mysql', PORT 3306);
--error ER_TCADMIN_CREATE_NODE_ERROR
TDBCTL CREATE NODE WRAPPER SPIDER OPTIONS (HOST '172.18.0.8', USER 'mysql', PASSWORD 'mysql') WITH SCHEMA;
--echo # The specified NUMBER already exists
--error ER_TCADMIN_CREATE_NODE_ERROR
TDBCTL CREATE NODE WRAPPER SPIDER OPTIONS (HOST '172.18.0.8', USER 'mysql', PASSWORD 'mysql', PORT 3306, NUMBER 1);
--error ER_TCADMIN_CREATE_NODE_ERROR
TDBCTL CREATE NODE WRAPPER SPIDER OPTIONS (HOST '172.18.0.8', USER 'mysql', PASSWORD 'mysql', PORT 3306, NUMBER 1) WITH SCHEMA;
--echo # The specified ip#port already exists
--error ER_TCADMIN_CREATE_NODE_ERROR
TDBCTL CREATE NODE WRAPPER SPIDER OPTIONS (HOST '172.18.0.5', USER 'mysql', PASSWORD 'mysql', PORT 3306);
--error ER_TCADMIN_CREATE_NODE_ERROR
TDBCTL CREATE NODE WRAPPER SPIDER OPTIONS (HOST '172.18.0.11', USER 'mysql', PASSWORD 'mysql', PORT 3306) WITH SCHEMA;
--echo # The specified ip is not consistent with the cluster
--error ER_TCADMIN_CREATE_NODE_ERROR
TDBCTL CREATE NODE WRAPPER SPIDER OPTIONS (HOST '127.0.0.1', USER 'mysql', PASSWORD 'mysql', PORT 3306);
--error ER_TCADMIN_CREATE_NODE_ERROR
TDBCTL CREATE NODE WRAPPER SPIDER OPTIONS (HOST 'localhost', USER 'mysql', PASSWORD 'mysql', PORT 3306) WITH SCHEMA;

--echo
--echo # Restore mysql.servers;
--connection tdbctl0
SET tc_admin=OFF;
TRUNCATE mysql.servers;
INSERT INTO mysql.servers SELECT * FROM origin_servers;
SET tc_admin=ON;
TDBCTL FLUSH ROUTING;


--echo
--echo # Set general_log output to table.
--source suite/tdbctl/inc/set_cluster_general_log_to_table.inc

--echo
--echo # Set routing.
--connection tdbctl0
SET tc_admin=ON;
TDBCTL DROP NODE SPIDER2;
TDBCTL FLUSH ROUTING;

--echo
--echo # Show routing.
--connection tdbctl0
SELECT * FROM mysql.servers;

--echo
--echo # Case 1: TDBCTL CREATE NODE.
--echo # Truncate general_log.
--source suite/tdbctl/inc/truncate_cluster_general_log.inc
--echo # execute TDBCTL CREATE NODE.
--connection tdbctl0
SET tc_admin=ON;
TDBCTL CREATE NODE WRAPPER SPIDER OPTIONS (HOST '172.18.0.8', USER 'mysql', PASSWORD 'mysql', PORT 3306);
--echo # show general_log.
--echo --------------------
--connection tdbctl0
SELECT argument AS tdbctl0_log FROM mysql.general_log WHERE (user_host LIKE '%172.18.0.9%' OR thread_id = CONNECTION_ID()) AND argument NOT LIKE '%tdbctl0_log%' AND command_type NOT LIKE 'Connect';
--echo --------------------
--connection tdbctl1
SELECT argument AS tdbctl1_log FROM mysql.general_log WHERE user_host LIKE '%172.18.0.9%' AND argument NOT LIKE '%tdbctl1_log%' AND command_type NOT LIKE 'Connect';
--echo --------------------
--connection tdbctl2
SELECT argument AS tdbctl2_log FROM mysql.general_log WHERE user_host LIKE '%172.18.0.9%' AND argument NOT LIKE '%tdbctl2_log%' AND command_type NOT LIKE 'Connect';
--echo --------------------
--connection spider0
SELECT argument AS spider0_log FROM mysql.general_log WHERE user_host LIKE '%172.18.0.9%' AND argument NOT LIKE '%spider0_log%' AND command_type NOT LIKE 'Connect';
--echo --------------------
--connection spider1
SELECT argument AS spider1_log FROM mysql.general_log WHERE user_host LIKE '%172.18.0.9%' AND argument NOT LIKE '%spider1_log%' AND command_type NOT LIKE 'Connect';
--echo --------------------
--connection spider2
SELECT argument AS spider2_log FROM mysql.general_log WHERE user_host LIKE '%172.18.0.9%' AND argument NOT LIKE '%spider2_log%' AND command_type NOT LIKE 'Connect';
--echo --------------------
--echo # tdbctl0 routing table
--connection tdbctl0
SELECT * FROM mysql.servers;
--echo # tdbctl1 routing table
--connection tdbctl1
SELECT * FROM mysql.servers;
--echo # tdbctl2 routing table
--connection tdbctl2
SELECT * FROM mysql.servers;
--echo # spider0 routing table
--connection spider0
SELECT * FROM mysql.servers ORDER BY Host;
--echo # spider1 routing table
--connection spider1
SELECT * FROM mysql.servers ORDER BY Host;
--echo # spider2 routing table
--connection spider2
SELECT * FROM mysql.servers ORDER BY Host;

--echo
--echo # Set routing.
--connection tdbctl0
SET tc_admin=ON;
TDBCTL DROP NODE SPIDER2;
TDBCTL FLUSH ROUTING;

--echo
--echo # Show routing.
--connection tdbctl0
SELECT * FROM mysql.servers;

--echo
--echo # Case 2: TDBCTL CREATE SPIDER NODE WITH SCHEMA.
--echo # Truncate general_log.
--source suite/tdbctl/inc/truncate_cluster_general_log.inc
--echo # execute TDBCTL CREATE NODE WITH SCHEMA.
--connection tdbctl0
SET tc_admin=ON;
SET GLOBAL tc_skip_dump_db_list = "performance_schema,information_schema,mysql,test,db_infobase,my-test";
SET GLOBAL tc_skip_check_db_list = "performance_schema,information_schema,mysql,test,sys,db_infobase,my-test";
TDBCTL CREATE NODE WRAPPER SPIDER OPTIONS (HOST '172.18.0.8', USER 'mysql', PASSWORD 'mysql', PORT 3306) WITH SCHEMA;
--echo # show general_log.
--echo --------------------
--connection tdbctl0
SELECT argument AS tdbctl0_log FROM mysql.general_log WHERE (user_host LIKE '%172.18.0.9%' OR thread_id = CONNECTION_ID()) AND argument NOT LIKE '%tdbctl0_log%' AND command_type NOT LIKE 'Connect';
--echo --------------------
--connection tdbctl1
SELECT argument AS tdbctl1_log FROM mysql.general_log WHERE user_host LIKE '%172.18.0.9%' AND argument NOT LIKE '%tdbctl1_log%' AND command_type NOT LIKE 'Connect';
--echo --------------------
--connection tdbctl2
SELECT argument AS tdbctl2_log FROM mysql.general_log WHERE user_host LIKE '%172.18.0.9%' AND argument NOT LIKE '%tdbctl2_log%' AND command_type NOT LIKE 'Connect';
--echo --------------------
--connection spider0
SELECT argument AS spider0_log FROM mysql.general_log WHERE user_host LIKE '%172.18.0.9%' AND argument NOT LIKE '%spider0_log%' AND command_type NOT LIKE 'Connect';
--echo --------------------
--connection spider1
SELECT argument AS spider1_log FROM mysql.general_log WHERE user_host LIKE '%172.18.0.9%' AND argument NOT LIKE '%spider1_log%' AND command_type NOT LIKE 'Connect';
--echo --------------------
--connection spider2
SELECT argument AS spider2_log FROM mysql.general_log WHERE user_host LIKE '%172.18.0.9%' AND argument NOT LIKE '%spider2_log%' AND command_type NOT LIKE 'Connect';
--echo --------------------
--echo # tdbctl0 routing table
--connection tdbctl0
SELECT * FROM mysql.servers;
--echo # tdbctl1 routing table
--connection tdbctl1
SELECT * FROM mysql.servers;
--echo # tdbctl2 routing table
--connection tdbctl2
SELECT * FROM mysql.servers;
--echo # spider0 routing table
--connection spider0
SELECT * FROM mysql.servers ORDER BY Host;
--echo # spider1 routing table
--connection spider1
SELECT * FROM mysql.servers ORDER BY Host;
--echo # spider2 routing table
--connection spider2
SELECT * FROM mysql.servers ORDER BY Host;

