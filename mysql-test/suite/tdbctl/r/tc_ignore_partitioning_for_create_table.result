CREATE TABLE tb8 (
id INT NOT NULL,
value INT NOT NULL,
PRIMARY KEY(`id`)
) PARTITION BY RANGE (id % 2) (
PARTITION `p0` VALUES LESS THAN (1),
PARTITION `p1` VALUES LESS THAN (2)
);
