SELECT * FROM mysql.servers;
Server_name	Host	Db	Username	Password	Port	Socket	Wrapper	Owner
SPIDER0	172.18.0.6		mysql	mysql	3306		SPIDER	
SPIDER1	172.18.0.7		mysql	mysql	3306		SPIDER	
SPIDER2	172.18.0.8		mysql	mysql	3306		SPIDER	
SPT0	172.18.0.2		mysql	mysql	3306		mysql	
SPT1	172.18.0.3		mysql	mysql	3306		mysql	
SPT_SLAVE0	172.18.0.4		mysql	mysql	3306		mysql_slave	
SPT_SLAVE1	172.18.0.5		mysql	mysql	3306		mysql_slave	
TDBCTL0	172.18.0.9		mysql	mysql	3306		TDBCTL	
TDBCTL1	172.18.0.10		mysql	mysql	3306		TDBCTL	
TDBCTL2	172.18.0.11		mysql	mysql	3306		TDBCTL	
SELECT @@session.tc_admin INTO @origin_tc_admin;
SELECT @@global.tc_ignore_partitioning_for_create_table INTO @origin_tc_ignore_partition;

# case 1: when tc_admin=0, tc_ignore_partitioning_for_create_table has no effect.
SET tc_admin=0;
SET GLOBAL tc_ignore_partitioning_for_create_table=1;
CREATE DATABASE test1;
USE test1;
CREATE TABLE tb1 (
id INT NOT NULL,
value INT NOT NULL
) PARTITION BY KEY (id) PARTITIONS 2;
SHOW CREATE TABLE tb1;
Table	Create Table
tb1	CREATE TABLE `tb1` (
  `id` int(11) NOT NULL,
  `value` int(11) NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=utf8
/*!50100 PARTITION BY KEY (id)
PARTITIONS 2 */
SELECT TABLE_NAME, PARTITION_METHOD, PARTITION_EXPRESSION, PARTITION_DESCRIPTION
FROM INFORMATION_SCHEMA.PARTITIONS WHERE TABLE_NAME = 'tb1';
TABLE_NAME	PARTITION_METHOD	PARTITION_EXPRESSION	PARTITION_DESCRIPTION
tb1	KEY	`id`	NULL
tb1	KEY	`id`	NULL

# case 2: when tc_admin=1 and tc_ignore_partitioning_for_create_table=1, 'PARTITION BY' will be ignored; 
SET tc_admin=1;
SET GLOBAL tc_ignore_partitioning_for_create_table=1;
CREATE DATABASE test2;
USE test2;
# SPIDER ENGINE
CREATE TABLE tb2 (
id INT NOT NULL,
value INT NOT NULL,
PRIMARY KEY(`id`)
)ENGINE=SPIDER DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_bin
PARTITION BY LIST (crc32(`id`) MOD 2)
(PARTITION `pt0` VALUES IN (0) COMMENT = 'database "test2_0", table "tb2", server "SPT0"' ENGINE = SPIDER, 
PARTITION `pt1` VALUES IN (1) COMMENT = 'database "test2_1", table "tb2", server "SPT1"' ENGINE = SPIDER);
Warnings:
Warning	1286	Unknown storage engine 'SPIDER'
Warning	1286	Unknown storage engine 'SPIDER'
Warning	1286	Unknown storage engine 'SPIDER'
Warning	1266	Using storage engine InnoDB for table 'tb2'
SHOW CREATE TABLE tb2;
