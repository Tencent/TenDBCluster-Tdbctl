# case 1: when tc_admin=0, tc_ignore_partitioning_for_create_table also takes effect.
SET tc_admin=0;
SET GLOBAL tc_ignore_partitioning_for_create_table=1;
CREATE DATABASE test1;
USE test1;
CREATE TABLE `query_response_time` (
`ip` varchar(15) NOT NULL DEFAULT '',
`time_min` smallint(6) NOT NULL DEFAULT '0',
`port` smallint(5) unsigned NOT NULL DEFAULT '3306',
`report_day` int(11) NOT NULL DEFAULT '0',
`update_time` int(11) unsigned DEFAULT NULL,
`query_res_1ms` int(11) DEFAULT NULL,
`query_res_4ms` int(11) DEFAULT NULL,
`query_res_16ms` int(11) DEFAULT NULL,
`query_res_64ms` int(11) DEFAULT NULL,
`query_res_250ms` int(11) DEFAULT NULL,
`query_res_1s` int(11) DEFAULT NULL,
`query_res_gt1s` int(11) DEFAULT NULL,
PRIMARY KEY (`ip`,`port`,`report_day`,`time_min`),
KEY `report_day_index` (`report_day`),
KEY `h_update_time` (`update_time`)
) ENGINE=ROCKSDB DEFAULT CHARSET=latin1 COMMENT='shard_key "ip"'
/*!50100 PARTITION BY RANGE (report_day)
