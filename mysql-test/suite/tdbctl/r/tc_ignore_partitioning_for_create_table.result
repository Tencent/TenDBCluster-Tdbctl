# case 4: when tc_admin=1 and tc_ignore_partitioning_for_create_table=0, general 'PARTITION BY' clause on tdbctl node is allowed.
# default ENGINE
CREATE TABLE tb8 (
id INT NOT NULL,
value INT NOT NULL,
PRIMARY KEY(`id`)
) PARTITION BY RANGE (id % 2) (
PARTITION `p0` VALUES LESS THAN (1),
PARTITION `p1` VALUES LESS THAN (2)
);
SHOW CREATE TABLE tb8;
Table	Create Table
tb8	CREATE TABLE `tb8` (
  `id` int(11) NOT NULL,
  `value` int(11) NOT NULL,
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8
/*!50100 PARTITION BY RANGE (id % 2)
(PARTITION p0 VALUES LESS THAN (1) ENGINE = InnoDB,
 PARTITION p1 VALUES LESS THAN (2) ENGINE = InnoDB) */
SELECT TABLE_NAME, PARTITION_METHOD, PARTITION_EXPRESSION, PARTITION_DESCRIPTION
FROM INFORMATION_SCHEMA.PARTITIONS WHERE TABLE_NAME = 'tb8';
TABLE_NAME	PARTITION_METHOD	PARTITION_EXPRESSION	PARTITION_DESCRIPTION
tb8	RANGE	id % 2	1
tb8	RANGE	id % 2	2
TDBCTL CONNECT NODE SPIDER0 EXECUTE 'SHOW CREATE TABLE test3.tb8';
Table	Create Table
tb8	CREATE TABLE `tb8` (
  `id` int(11) NOT NULL,
  `value` int(11) NOT NULL,
  PRIMARY KEY (`id`)
) ENGINE=SPIDER DEFAULT CHARSET=utf8
 PARTITION BY LIST (crc32(`id`) MOD 2)
(PARTITION `pt0` VALUES IN (0) COMMENT = 'database "test3_0", table "tb8", server "SPT0"' ENGINE = SPIDER,
 PARTITION `pt1` VALUES IN (1) COMMENT = 'database "test3_1", table "tb8", server "SPT1"' ENGINE = SPIDER)
TDBCTL CONNECT NODE SPT0 EXECUTE 'SHOW CREATE TABLE test3_0.tb8';
