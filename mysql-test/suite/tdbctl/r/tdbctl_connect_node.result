'A',
'X,Y'
);
CREATE TABLE binary_table (
id INT PRIMARY KEY,
binary_data BINARY(10),
varbinary_data VARBINARY(255)
);
insert into binary_table values (1, BINARY 'hello', BINARY 'hello world');
tdbctl connect node SPIDER0 execute 'select * from all_data_types_example';
id	int_col	tinyint_col	smallint_col	mediumint_col	bigint_col	float_col	double_col	decimal_col	date_col	time_col	datetime_col	timestamp_col	year_col	char_col	varchar_col	tinyblob_col	blob_col	mediumblob_col	longblob_col	tinytext_col	text_col	mediumtext_col	longtext_col	enum_col	set_col
1	100	50	200	50000	123456789012345	12.34	56.78	90.12	2021-01-01	12:34:56	2021-01-01 12:34:56	2023-11-02 15:08:07	2022	hello	world	tinyblob data	blob data	mediumblob data	longblob data	tinytext data	text data	mediumtext data	longtext data	A	X,Y
