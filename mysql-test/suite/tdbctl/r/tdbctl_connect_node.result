create database d1;
use d1;
create table t1 (a int primary key, b int);
insert into t1 values(1,1);
insert into t1 values(2,2);
insert into t1 values(3,3);
insert into t1 values(4,4);
insert into t1 values(5,5);
insert into t1 values(6,6);
tdbctl connect node SPIDER0 execute 'select * from d1.t1';
a	b
4	4
5	5
6	6
1	1
2	2
3	3
tdbctl connect node SPT0 execute 'select * from d1_0.t1';
a	b
4	4
5	5
6	6
tdbctl connect node SPT1 execute 'select * from d1_1.t1';
a	b
1	1
2	2
3	3
CREATE TABLE all_data_types_example (
id INT AUTO_INCREMENT PRIMARY KEY,
int_col INT,
tinyint_col TINYINT,
smallint_col SMALLINT,
mediumint_col MEDIUMINT,
bigint_col BIGINT,
float_col FLOAT,
double_col DOUBLE,
decimal_col DECIMAL(10, 2),
date_col DATE,
time_col TIME,
datetime_col DATETIME,
timestamp_col TIMESTAMP,
year_col YEAR,
char_col CHAR(10),
varchar_col VARCHAR(255),
tinyblob_col TINYBLOB,
blob_col BLOB,
mediumblob_col MEDIUMBLOB,
longblob_col LONGBLOB,
tinytext_col TINYTEXT,
text_col TEXT,
mediumtext_col MEDIUMTEXT,
longtext_col LONGTEXT,
enum_col ENUM('A', 'B', 'C'),
set_col SET('X', 'Y', 'Z')
);
INSERT INTO all_data_types_example (
