SPIDER	test1	t1	USE `test1`;create table t1(a int primary key) PARTITION BY LIST(CRC32(`a`) % 2) (PARTITION pt0 VALUES IN (0) COMMENT = 'database "test1_0", table "t1", server "SPT0"' ENGINE = SPIDER, PARTITION pt1 VALUES IN (1) COMMENT = 'database "test1_1", table "t1", server "SPT1"' ENGINE = SPIDER);	all spider execute
SPT0	NULL	NULL	use `test1_0`;create table t1(a int primary key)	all remote execute
