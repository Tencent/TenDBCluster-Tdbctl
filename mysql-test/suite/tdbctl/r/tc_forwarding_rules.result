# Check modified forwarding rules for SQLCOM_LOCK_TABLES, SQLCOM_UNLOCK_TABLES, and SQLCOM_SELECT command.
# Truncate general_log.
execute 'TRUNCATE TABLE mysql.general_log;' on all cluster nodes.
# Execute SQLCOM_LOCK_TABLES, SQLCOM_UNLOCK_TABLES, and SQLCOM_SELECT command.
# Go to the new session.
SET tc_admin=ON;
CREATE DATABASE test1;
USE test1;
CREATE TABLE t1( id INT PRIMARY KEY );
CREATE TABLE t2( id INT PRIMARY KEY );
LOCK TABLES t1 READ, t2 WRITE;
SELECT * FROM t1;
id
UNLOCK TABLES;
DROP DATABASE test1;
# show general_log.
--------------------
SELECT argument AS tdbctl0_log FROM mysql.general_log WHERE (user_host LIKE '%172.18.0.9%' OR thread_id = CONNECTION_ID()) AND argument NOT LIKE '%tdbctl0_log%' AND command_type NOT LIKE 'Connect';
tdbctl0_log
SET tc_admin=ON
CREATE DATABASE test1
USE test1
CREATE TABLE t1( id INT PRIMARY KEY )
CREATE TABLE t2( id INT PRIMARY KEY )
LOCK TABLES t1 READ, t2 WRITE
SELECT * FROM t1
UNLOCK TABLES
DROP DATABASE test1
