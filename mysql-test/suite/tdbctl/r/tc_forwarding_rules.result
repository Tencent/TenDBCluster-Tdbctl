TDBCTL2	172.18.0.11		mysql	mysql	3306		TDBCTL	
SELECT @@SESSION.tc_admin INTO @origin_tc_admin;
SELECT @@GLOBAL.tc_forwarding_rules INTO @origin_global_rules;
SELECT @@SESSION.tc_forwarding_rules INTO @origin_session_rules;

# Test invalid forwarding rules.
SET tc_forwarding_rules = '""';
ERROR HY000: Failed to set sql-level forwarding rules: Only allow json text of type J_OBJECT
SET tc_forwarding_rules = '{"SQLCOM_LOCK_TABLES", "TDBCTL", "SQLCOM_UNLOCK_TABLES", "TDBCTL"}';
ERROR HY000: Failed to set sql-level forwarding rules: Error when parsing json text: Invalid json string: '{"SQLCOM_LOCK_TABLES", "TDBCTL", "SQLCOM_UNLOCK_TABLES", "TDBCTL"}'
SET tc_forwarding_rules = '{SQLCOM_LOCK_TABLES: "TDBCTL", SQLCOM_UNLOCK_TABLES: "TDBCTL"}';
ERROR HY000: Failed to set sql-level forwarding rules: Error when parsing json text: Invalid json string: '{SQLCOM_LOCK_TABLES: "TDBCTL", SQLCOM_UNLOCK_TABLES: "TDBCTL"}'
SET tc_forwarding_rules = '{"SQLCOM_LOCK_TABLES": 123}';
ERROR HY000: Failed to set sql-level forwarding rules: The value set to the key 'SQLCOM_LOCK_TABLES' is not a string
SET tc_forwarding_rules = '{"SQLCOM_LOCK_TABLE": "TDBCTL"}';
ERROR HY000: Failed to set sql-level forwarding rules: Unknown sql command 'SQLCOM_LOCK_TABLE'
SET tc_forwarding_rules = '{"SQLCOM_CREATE_TABLE": "TDBCTL, SPIDER_ALL"}';
ERROR HY000: Failed to set sql-level forwarding rules: Setting forwarding rule for sql command 'SQLCOM_CREATE_TABLE' is forbidden (tips: Cannot change forwarding rules for DDL sql commands.)
SET tc_forwarding_rules = '{"SQLCOM_LOCK_TABLES": "TDBCTL, SPIDER_ALL", "sqlcom_lock_tables": "TDBCTL, SPIDER_ALL"}';
ERROR HY000: Failed to set sql-level forwarding rules: Duplicate sql command 'SQLCOM_LOCK_TABLES'
SET tc_forwarding_rules = '{"SQLCOM_LOCK_TABLES": ""}';
ERROR HY000: Failed to set sql-level forwarding rules: Empty string for key 'SQLCOM_LOCK_TABLES'
SET tc_forwarding_rules = '{"SQLCOM_LOCK_TABLES": "TDBCTL_ALL"}';
ERROR HY000: Failed to set sql-level forwarding rules: Invalid execute flag 'TDBCTL_ALL'
SET tc_forwarding_rules = '{"SQLCOM_LOCK_TABLES": "DESIGNATED_ONE"}';
ERROR HY000: Failed to set sql-level forwarding rules: This flag cannot be specified by users: 'DESIGNATED_ONE'
SET tc_forwarding_rules = '{"SQLCOM_LOCK_TABLES": "SPIDER_ALL, TDBCTL, SPIDER_ALL"}';
ERROR HY000: Failed to set sql-level forwarding rules: Duplicate execute flag 'SPIDER_ALL'
SET tc_forwarding_rules = '{"SQLCOM_LOCK_TABLES": "SPIDER_ALL, TDBCTL, SPIDER_ONE"}';
ERROR HY000: Failed to set sql-level forwarding rules: Conflicting execute flags exist for 'SQLCOM_LOCK_TABLES'
SET tc_forwarding_rules = '{"SQLCOM_GRANT": "TDBCTL, SPIDER_ALL"}';
ERROR HY000: Failed to set sql-level forwarding rules: Out-of-range flags exist for 'SQLCOM_GRANT', max supported rule is 'TDBCTL'

# Set global tc_forwarding_rules. Only new sessions will be affected.
SHOW SESSION VARIABLES LIKE 'tc_forwarding_rules';
Variable_name	Value
tc_forwarding_rules	{}
SHOW GLOBAL VARIABLES LIKE 'tc_forwarding_rules';
Variable_name	Value
tc_forwarding_rules	{}
SET GLOBAL tc_forwarding_rules = '{"SQLCOM_LOCK_TABLES": "TDBCTL", "SQLCOM_UNLOCK_TABLES": "TDBCTL, SPIDER_ONE", "SQLCOM_FLUSH": "TDBCTL"}';
SHOW GLOBAL VARIABLES LIKE 'tc_forwarding_rules';
Variable_name	Value
tc_forwarding_rules	{"SQLCOM_LOCK_TABLES": "TDBCTL", "SQLCOM_UNLOCK_TABLES": "TDBCTL, SPIDER_ONE", "SQLCOM_FLUSH": "TDBCTL"}
SET @@GLOBAL.tc_forwarding_rules = JSON_SET(@@GLOBAL.tc_forwarding_rules, '$.SQLCOM_SELECT', 'NO_EXEC');
SHOW GLOBAL VARIABLES LIKE 'tc_forwarding_rules';
Variable_name	Value
tc_forwarding_rules	{"SQLCOM_FLUSH": "TDBCTL", "SQLCOM_SELECT": "NO_EXEC", "SQLCOM_LOCK_TABLES": "TDBCTL", "SQLCOM_UNLOCK_TABLES": "TDBCTL, SPIDER_ONE"}
SET @@GLOBAL.tc_forwarding_rules = JSON_REMOVE(@@GLOBAL.tc_forwarding_rules, '$.SQLCOM_FLUSH');
SHOW GLOBAL VARIABLES LIKE 'tc_forwarding_rules';
Variable_name	Value
tc_forwarding_rules	{"SQLCOM_SELECT": "NO_EXEC", "SQLCOM_LOCK_TABLES": "TDBCTL", "SQLCOM_UNLOCK_TABLES": "TDBCTL, SPIDER_ONE"}
SET @@GLOBAL.tc_forwarding_rules = JSON_SET(@@GLOBAL.tc_forwarding_rules, '$.SQLCOM_UNLOCK_TABLES', 'TDBCTL');
SHOW GLOBAL VARIABLES LIKE 'tc_forwarding_rules';
Variable_name	Value
tc_forwarding_rules	{"SQLCOM_SELECT": "NO_EXEC", "SQLCOM_LOCK_TABLES": "TDBCTL", "SQLCOM_UNLOCK_TABLES": "TDBCTL"}
SELECT JSON_EXTRACT(@@GLOBAL.tc_forwarding_rules, '$.SQLCOM_UNLOCK_TABLES') AS SQLCOM_UNLOCK_TABLES;
SQLCOM_UNLOCK_TABLES
"TDBCTL"
SHOW SESSION VARIABLES LIKE 'tc_forwarding_rules';
Variable_name	Value
tc_forwarding_rules	{}

# Create new connection.
SHOW GLOBAL VARIABLES LIKE 'tc_forwarding_rules';
Variable_name	Value
tc_forwarding_rules	{"SQLCOM_SELECT": "NO_EXEC", "SQLCOM_LOCK_TABLES": "TDBCTL", "SQLCOM_UNLOCK_TABLES": "TDBCTL"}
SHOW SESSION VARIABLES LIKE 'tc_forwarding_rules';
Variable_name	Value
tc_forwarding_rules	{"SQLCOM_SELECT": "NO_EXEC", "SQLCOM_LOCK_TABLES": "TDBCTL", "SQLCOM_UNLOCK_TABLES": "TDBCTL"}

# Set general_log output to table.
Set general log for all cluster nodes.

# Check default forwarding rules for SQLCOM_LOCK_TABLES, SQLCOM_UNLOCK_TABLES, and SQLCOM_SELECT command.
# Truncate general_log.
execute 'TRUNCATE TABLE mysql.general_log;' on all cluster nodes.
# Execute SQLCOM_LOCK_TABLES, SQLCOM_UNLOCK_TABLES, and SQLCOM_SELECT command.
# Still in the old session.
SET tc_admin=ON;
CREATE DATABASE test1;
USE test1;
CREATE TABLE t1( id INT PRIMARY KEY );
CREATE TABLE t2( id INT PRIMARY KEY );
LOCK TABLES t1 READ, t2 WRITE;
SELECT * FROM t1;
id
UNLOCK TABLES;
DROP DATABASE test1;
# Show general_log.
--------------------
SELECT argument AS tdbctl0_log FROM mysql.general_log WHERE (user_host LIKE '%172.18.0.9%' OR thread_id = CONNECTION_ID()) AND argument NOT LIKE '%tdbctl0_log%' AND command_type NOT LIKE 'Connect';
tdbctl0_log
