TDBCTL2	172.18.0.11		mysql	mysql	3306		TDBCTL	
SELECT @@SESSION.tc_admin INTO @origin_tc_admin;
SELECT @@SESSION.tc_enable_autoinc_check INTO @origin_tc_enable_autoinc_check;
SELECT @@GLOBAL.tc_skip_dump_db_list INTO @origin_tc_skip_dump_db_list;
SELECT @@GLOBAL.tc_skip_check_db_list INTO @origin_tc_skip_check_db_list;
SET tc_admin=OFF;
CREATE TEMPORARY TABLE origin_servers LIKE mysql.servers;
INSERT INTO origin_servers SELECT * FROM mysql.servers;

# Disable tc_enable_autoinc_check
SET tc_enable_autoinc_check = OFF;

# Set general_log output to table.
Set general log for all cluster nodes.

# Test Empty routing table
# Truncate mysql.servers.
SET tc_admin=OFF;
DELETE FROM mysql.servers;
# execute TDBCTL FLUSH ROUTING command.
SET tc_admin=ON;
TDBCTL FLUSH ROUTING;
ERROR HY000: failed to flush routing: no tdbctl node found

# Only primary tdbctl
execute 'TRUNCATE TABLE mysql.general_log;' on all cluster nodes.
SET tc_admin = ON;
TDBCTL CREATE NODE WRAPPER TDBCTL OPTIONS (HOST '172.18.0.9', USER 'mysql', PASSWORD 'mysql', PORT 3306) WITH SCHEMA;
ERROR HY000: Internal error: failed to identify current server
TDBCTL CREATE NODE WRAPPER TDBCTL OPTIONS (HOST '172.18.0.9', USER 'mysql', PASSWORD 'mysql', PORT 3306);
