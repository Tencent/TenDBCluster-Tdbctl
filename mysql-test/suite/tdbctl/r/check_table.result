# Case 3: Inconsistent table collation or table engine.
# Make difference
SET SESSION ddl_execute_by_ctl = OFF;
ALTER TABLE test_check_table.t1 CONVERT TO CHARACTER SET latin1;
ALTER TABLE test_check_table.t2 ENGINE = MyISAM;
ALTER TABLE test_check_table_0.t1 CONVERT TO CHARACTER SET latin1;
ALTER TABLE test_check_table_0.t2 ENGINE = MyISAM;
# Execute TDBCTL CHECK TABLES.
SET tc_admin = ON;
TDBCTL CHECK TABLES IN test_check_table;
Server_name	Db	Table	Status	Message
SPIDER0	test_check_table	t1	Error	(1)Expected table collation to be 'utf8_general_ci', but actually is 'latin1_swedish_ci'
SPIDER1	test_check_table	t1	OK	
SPIDER2	test_check_table	t1	OK	
SPT0	test_check_table_0	t1	Error	(1)Expected table collation to be 'utf8_general_ci', but actually is 'latin1_swedish_ci'
SPT1	test_check_table_1	t1	OK	
SPIDER0	test_check_table	t2	Error	(1)Expected table engine to be 'SPIDER', but actually is 'MyISAM'
SPIDER1	test_check_table	t2	OK	
SPIDER2	test_check_table	t2	OK	
SPT0	test_check_table_0	t2	Error	(1)Expected table engine to be 'InnoDB', but actually is 'MyISAM'
SPT1	test_check_table_1	t2	OK	
SPIDER0	test_check_table	u1	OK	
SPIDER1	test_check_table	u1	OK	
SPIDER2	test_check_table	u1	OK	
SPT0	test_check_table_0	u1	OK	
SPT1	test_check_table_1	u1	OK	

# Reset tables.
SET tc_admin = ON;
DROP DATABASE IF EXISTS test_check_table;
CREATE DATABASE test_check_table;
USE test_check_table;
CREATE TABLE t1(f1 INT PRIMARY KEY, f2 SMALLINT);
CREATE TABLE t2(f1 INT PRIMARY KEY, f2 INT, f3 INT);
CREATE TABLE t2_5(f1 INT PRIMARY KEY, f2 VARCHAR(10) CHARACTER SET utf8);
ERROR HY000: CREATE TABLE FAILED: ERROR: UNSUPPORT SQL CREATE TABLE WITH FIELD_CHARSET
CREATE TABLE t3(f1 INT PRIMARY KEY, f2 VARCHAR(10)) DEFAULT CHARSET=utf8;
CREATE TABLE t4(f1 INT PRIMARY KEY, f2 INT, f3 INT, INDEX index_f3(f3));

# Case 4: Inconsistent column data_type/ordinal_position/collation/key
# Make difference
SET SESSION ddl_execute_by_ctl = OFF;
ALTER TABLE test_check_table.t1 MODIFY COLUMN f2 INT;
ALTER TABLE test_check_table.t2 MODIFY COLUMN f2 INT AFTER f3;
Not allowed: ALTER TABLE test_check_table.t3 MODIFY COLUMN f2 VARCHAR(10) CHARACTER SET latin1;
ALTER TABLE test_check_table.t4 ADD INDEX index_f2(f2);
ALTER TABLE test_check_table_1.t1 MODIFY COLUMN f2 INT;
ALTER TABLE test_check_table_1.t2 MODIFY COLUMN f2 INT FIRST;
ALTER TABLE test_check_table_1.t3 MODIFY COLUMN f2 VARCHAR(10) CHARACTER SET latin1;
ALTER TABLE test_check_table_1.t4 DROP INDEX index_f3;
# Execute TDBCTL CHECK TABLES.
SET tc_admin = ON;
TDBCTL CHECK TABLES IN test_check_table;
