# tdbctl routing table
SELECT * FROM mysql.servers;
Server_name	Host	Db	Username	Password	Port	Socket	Wrapper	Owner
SPIDER0	172.18.0.6		mysql	mysql	3306		SPIDER	
SPIDER1	172.18.0.7		mysql	mysql	3306		SPIDER	
SPIDER2	172.18.0.8		mysql	mysql	3306		SPIDER	
SPT0	172.18.0.2		mysql	mysql	3306		mysql	
SPT1	172.18.0.3		mysql	mysql	3306		mysql	
SPT_SLAVE0	172.18.0.4		mysql	mysql	3306		mysql_slave	
SPT_SLAVE1	172.18.0.5		mysql	mysql	3306		mysql_slave	
TDBCTL0	172.18.0.9		mysql	mysql	3306		TDBCTL	
TDBCTL1	172.18.0.10		mysql	mysql	3306		TDBCTL	
TDBCTL2	172.18.0.11		mysql	mysql	3306		TDBCTL	
# spider routing table
SELECT * FROM mysql.servers;
Server_name	Host	Db	Username	Password	Port	Socket	Wrapper	Owner
SPIDER0	172.18.0.6		mysql	mysql	3306		SPIDER	
SPIDER1	172.18.0.7		mysql	mysql	3306		SPIDER	
SPT1	172.18.0.3		mysql	mysql	3306		mysql	
SPT0	172.18.0.2		mysql	mysql	3306		mysql	
SPIDER2	172.18.0.8		mysql	mysql	3306		SPIDER	
TDBCTL0	172.18.0.9		mysql	mysql	3306		TDBCTL	

# Restore mysql.servers;
SET tc_admin=OFF;
TRUNCATE mysql.servers;
INSERT INTO mysql.servers SELECT * FROM origin_servers;
SET tc_admin=ON;
TDBCTL FLUSH ROUTING;

# Case 4: Switch master and slave nodes.
# Truncate general_log.
execute 'TRUNCATE TABLE mysql.general_log;' on all cluster nodes.
# Switch master and slave nodes.
SET tc_admin=ON;
TDBCTL ALTER NODE SPT0 OPTIONS (host '127.0.0.4', port 3306) WITH SYNC;
TDBCTL ALTER NODE SPT1 OPTIONS (host '127.0.0.5', port 3306) WITH SYNC;
FLUSH TABLE WITH READ LOCK;
FLUSH TABLE WITH READ LOCK;
FLUSH TABLE WITH READ LOCK;
SET tc_admin=ON;
TDBCTL FLUSH ROUTING CACHE;
UNLOCK TABLES;
UNLOCK TABLES;
UNLOCK TABLES;
# show general_log.
--------------------
SELECT argument AS tdbctl0_log FROM mysql.general_log WHERE (user_host LIKE '%172.18.0.9%' OR thread_id = CONNECTION_ID()) AND argument NOT LIKE '%tdbctl0_log%' AND command_type NOT LIKE 'Connect';
tdbctl0_log
SET tc_admin=ON
TDBCTL ALTER NODE SPT0 OPTIONS (host '127.0.0.4', port 3306) WITH SYNC
show variables like  'server_uuid'

TDBCTL ALTER NODE SPT1 OPTIONS (host '127.0.0.5', port 3306) WITH SYNC
show variables like  'server_uuid'

SET tc_admin=ON
TDBCTL FLUSH ROUTING CACHE
show variables like  'server_uuid'

