TDBCTL FLUSH ROUTING;

# Case 3: Fail to execute 'TDBCTL ALTER NODE WITH SYNC'.
# Truncate general_log.
execute 'TRUNCATE TABLE mysql.general_log;' on all cluster nodes.
# Lock mysql.servers of SPIDER0
LOCK TABLES mysql.servers READ;
# execute TDBCTL ALTER NODE WITH SYNC.
SET tc_admin=ON;
TDBCTL ALTER NODE SPT0 OPTIONS (host '127.0.0.4', port 3306) WITH SYNC;
ERROR HY000: ALTER NODE FAILED: with sync option, failed to modify mysql.servers table
SPIDER0: Lock wait timeout exceeded; try restarting transaction.
# Unlock mysql.servers of SPIDER0
UNLOCK TABLES;
# show general_log.
