# Test invalid variable forwarding rules.
SET tc_set_forwarding_rules = NULL;
ERROR HY000: Failed to set variable-level forwarding rules: Error when parsing json text: Get a null pointer of json text
SET tc_set_forwarding_rules = '""';
ERROR HY000: Failed to set variable-level forwarding rules: Only allow json text of type J_OBJECT
SET tc_set_forwarding_rules = '{"max_connections", "TDBCTL", "time_zone", "TDBCTL"}';
ERROR HY000: Failed to set variable-level forwarding rules: Error when parsing json text: Invalid json string: '{"max_connections", "TDBCTL", "time_zone", "TDBCTL"}'
SET tc_set_forwarding_rules = '{max_connections: "TDBCTL", time_zone: "TDBCTL"}';
ERROR HY000: Failed to set variable-level forwarding rules: Error when parsing json text: Invalid json string: '{max_connections: "TDBCTL", time_zone: "TDBCTL"}'
SET tc_set_forwarding_rules = '{"time_zone": 123}';
ERROR HY000: Failed to set variable-level forwarding rules: The value set to the key 'time_zone' is not a string
SET tc_set_forwarding_rules = '{"tc_admin": "TDBCTL, SPIDER_ALL"}';
ERROR HY000: Failed to set variable-level forwarding rules: Setting forwarding rule for system variable 'tc_admin' is forbidden (tips: system variable 'tc_admin' is a tdbctl variable)
SET tc_set_forwarding_rules = '{"time_zone": ""}';
ERROR HY000: Failed to set variable-level forwarding rules: Empty string for key 'time_zone'
SET tc_set_forwarding_rules = '{"time_zone": "TDBCTL_ALL"}';
ERROR HY000: Failed to set variable-level forwarding rules: Invalid execute flag 'TDBCTL_ALL'
SET tc_set_forwarding_rules = '{"time_zone": "DESIGNATED_ONE"}';
ERROR HY000: Failed to set variable-level forwarding rules: This flag cannot be specified by users: 'DESIGNATED_ONE'
SET tc_set_forwarding_rules = '{"time_zone": "SPIDER_ALL, TDBCTL, SPIDER_ALL"}';
ERROR HY000: Failed to set variable-level forwarding rules: Duplicate execute flag 'SPIDER_ALL'
SET tc_set_forwarding_rules = '{"time_zone": "SPIDER_ALL, TDBCTL, SPIDER_ONE"}';
ERROR HY000: Failed to set variable-level forwarding rules: Conflicting execute flags exist for 'time_zone'
SET tc_set_forwarding_rules = '{"Unknown_sys_var": "TDBCTL"}';
Warnings:
Warning	12056	When setting variable-level forwarding rules: unknown system variables: Unknown_sys_var
