# execute SQLCOM_SET_OPTION command.
SET tc_admin=ON;
SET @old_level = @@SESSION.tx_isolation;
SET SESSION TRANSACTION ISOLATION LEVEL REPEATABLE READ;
SET SESSION tx_isolation = @old_level;
